# Database configuration (defaults to SQLite with aiosqlite)
DATABASE_URL=sqlite+aiosqlite:///./crawler.db

# Redis configuration (optional: falls back to in-memory queue if unavailable)
REDIS_URL=redis://localhost:6379/0

# Crawler User-Agent configuration
CRAWLER_USER_AGENT=ContactDiscoveryBot/1.0 (+https://example.com/bot)

# Crawler default limits and safety settings
DEFAULT_REQUESTS_PER_SECOND=2.0
DEFAULT_CONCURRENCY=5
DEFAULT_MAX_PAGES=500
DEFAULT_MAX_DEPTH=5
DEFAULT_TIMEOUT=20
MAX_RESPONSE_SIZE_MB=10
MAX_REDIRECTS=5
MAX_QUEUE_SIZE=5000
MAX_RUNTIME_SECONDS=3600

# Security settings
ALLOW_PRIVATE_IPS=false

# Optional Browser Rendering (Playwright)
ENABLE_BROWSER_RENDERING=false

# Logging
LOG_LEVEL=INFO
